{
  "name": "playreggaemusic-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "PlayReggaeMusic.ai — public catalog + admin/agent console (Vite + React + TS)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
