rules_version = '2';

// B03 rules. Public-read catalog (admin-only writes), and engine collections
// (threads, checkpoints, checkpoint_writes, memory) fully closed to clients.
// The agent runtime reaches Firestore via the firebase-admin SDK, which
// bypasses these rules entirely — so denying all client access here does not
// impede the engine. Orders/masters stay private. Tightened further in B05.
service cloud.firestore {
  match /databases/{database}/documents {
    // Public catalog collections are world-readable, writes are admin-only.
    match /artists/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /releases/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /tracks/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /products/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Orders are not publicly readable. Tightened further in B05.
    match /orders/{doc} {
      allow read, write: if isAdmin();
    }

    // Engine collections: deny ALL client access. The admin SDK bypasses
    // rules, so the runtime is unaffected; no client may read or write.
    match /threads/{doc=**} {
      allow read, write: if false;
    }
    match /checkpoints/{doc=**} {
      allow read, write: if false;
    }
    match /checkpoint_writes/{doc=**} {
      allow read, write: if false;
    }
    match /memory/{doc=**} {
      allow read, write: if false;
    }

    // Default deny.
    match /{document=**} {
      allow read, write: if false;
    }

    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }
  }
}
