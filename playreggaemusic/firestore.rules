rules_version = '2';

// B05 rules. Public-read catalog (artists, releases, tracks, products) with
// admin-only writes; orders admin-only; track_masters fully closed to clients;
// engine collections (threads, checkpoints, checkpoint_writes, memory) fully
// closed to clients. The agent runtime reaches Firestore via the firebase-admin
// SDK, which bypasses these rules entirely — so denying all client access here
// does not impede the engine. The world-readable `tracks` doc carries ONLY
// public fields; the private master object path is stored separately in the
// admin-only `track_masters/{trackId}` collection (denied to all clients) so it
// never leaks to catalog readers. Audio master OBJECTS are NOT in Firestore;
// they live in private Storage (masters/... denied to all clients — see
// storage.rules).
service cloud.firestore {
  match /databases/{database}/documents {
    // Public catalog collections are world-readable, writes are admin-only.
    match /artists/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /releases/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /tracks/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /products/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Orders are admin-only (never publicly readable) — Polar order mirror.
    match /orders/{doc} {
      allow read, write: if isAdmin();
    }

    // Private track master paths: deny ALL client access. The admin SDK
    // bypasses rules, so the engine still reads/writes; no client may touch
    // these, keeping the private master object path out of public reach.
    match /track_masters/{doc=**} {
      allow read, write: if false;
    }

    // AI-provenance disclosure records (provenance/{trackId}): a TRANSPARENCY
    // artifact — PUBLIC-read so listeners can verify a recording is AI-generated,
    // but admin-write only. The admin SDK writes them; clients may only read.
    match /provenance/{doc=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Release distributions (distributions/{releaseId}): OPERATIONAL/admin-only.
    // Records the DSP delivery lifecycle (DDEX delivery id + status). Deny ALL
    // client access — the admin SDK bypasses rules, so the engine still
    // reads/writes; no client may read or write.
    match /distributions/{doc=**} {
      allow read, write: if false;
    }

    // SENSITIVE ownership splits (rights/{releaseId}): deny ALL client access.
    // Splits are commercially sensitive and must never be publicly readable.
    // The admin SDK bypasses rules, so the engine still reads/writes; no client
    // may read or write — the splits stay out of the public release doc/page.
    match /rights/{doc=**} {
      allow read, write: if false;
    }

    // Publishing & sync (P2B06, F8/F9). The works registry + sync catalog are
    // PUBLIC transparency artifacts (world-readable, admin-write); writer splits,
    // PRO/MLC affiliations, and sync licenses are SENSITIVE and admin-only (deny
    // ALL client access). The admin SDK bypasses rules so the engine + admin
    // callables still read/write; no client may touch the sensitive collections.
    match /works/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /sync_catalog/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    // SENSITIVE writer splits (work_splits/{workId}): never publicly readable —
    // splits stay out of the public works doc, exactly like rights/track_masters.
    match /work_splits/{doc=**} {
      allow read, write: if false;
    }
    // SENSITIVE PRO/MLC affiliations (pro_affiliations/{writerId}): member/IPI
    // ids — deny ALL client access.
    match /pro_affiliations/{doc=**} {
      allow read, write: if false;
    }
    // SENSITIVE sync licenses (sync_licenses/{id}): licensee/fee/binding terms —
    // deny ALL client access.
    match /sync_licenses/{doc=**} {
      allow read, write: if false;
    }

    // Autonomy orchestration (P2B04, F12): the agent audit log, pending
    // human-approval requests, and scheduled autonomous runs. All are
    // OPERATIONAL/admin-only — deny ALL client access. The admin SDK bypasses
    // rules so the runtime + admin callables still read/write; no client may.
    match /audit_log/{doc=**} {
      allow read, write: if false;
    }
    match /pending_approvals/{doc=**} {
      allow read, write: if false;
    }
    match /scheduled_runs/{doc=**} {
      allow read, write: if false;
    }

    // Royalties & finance (P2B05, F7): revenue events, per-artist recoupment
    // accounts, royalty statements, and payout records. All carry SENSITIVE
    // financial data — deny ALL client access. The admin SDK bypasses rules so
    // the engine + admin callables still read/write; no client may.
    match /revenue_events/{doc=**} {
      allow read, write: if false;
    }
    match /recoupment/{doc=**} {
      allow read, write: if false;
    }
    match /royalty_statements/{doc=**} {
      allow read, write: if false;
    }
    match /payouts/{doc=**} {
      allow read, write: if false;
    }

    // Marketing & promotion (P2B07, F5): release campaigns and the sent-log of
    // outward marketing events (social posts / email blasts / ad spend). Both are
    // OPERATIONAL/admin-only — deny ALL client access. The admin SDK bypasses
    // rules so the engine + admin callables still read/write; no client may.
    match /campaigns/{doc=**} {
      allow read, write: if false;
    }
    match /marketing_events/{doc=**} {
      allow read, write: if false;
    }

    // Analytics & A&R (P2B08, F11 + F1): ingested streaming/sales events, the
    // generated insight reports, and the A&R recommendation proposals. All are
    // BUSINESS INTELLIGENCE — admin-only, never public. Deny ALL client access.
    // The admin SDK bypasses rules so the engine + admin callables still
    // read/write; no client may read or write.
    match /analytics_events/{doc=**} {
      allow read, write: if false;
    }
    match /insight_reports/{doc=**} {
      allow read, write: if false;
    }
    match /anr_recommendations/{doc=**} {
      allow read, write: if false;
    }

    // Legal/Contracts/Compliance (P2B09, F10). Artist agreements carry SENSITIVE
    // commercial terms + personal AI-generation consent; structured license terms
    // are operational/owner-supplied wording. Both are admin-only — deny ALL
    // client access. The admin SDK bypasses rules so the engine + admin callables
    // still read/write; no client may read or write.
    match /artist_agreements/{doc=**} {
      allow read, write: if false;
    }
    match /license_terms/{doc=**} {
      allow read, write: if false;
    }

    // Engine collections: deny ALL client access. The admin SDK bypasses
    // rules, so the runtime is unaffected; no client may read or write.
    match /threads/{doc=**} {
      allow read, write: if false;
    }
    match /checkpoints/{doc=**} {
      allow read, write: if false;
    }
    match /checkpoint_writes/{doc=**} {
      allow read, write: if false;
    }
    match /memory/{doc=**} {
      allow read, write: if false;
    }

    // Default deny.
    match /{document=**} {
      allow read, write: if false;
    }

    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }
  }
}
