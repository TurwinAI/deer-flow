rules_version = '2';

// B05 rules. Public-read catalog (artists, releases, tracks, products) with
// admin-only writes; orders admin-only; track_masters fully closed to clients;
// engine collections (threads, checkpoints, checkpoint_writes, memory) fully
// closed to clients. The agent runtime reaches Firestore via the firebase-admin
// SDK, which bypasses these rules entirely — so denying all client access here
// does not impede the engine. The world-readable `tracks` doc carries ONLY
// public fields; the private master object path is stored separately in the
// admin-only `track_masters/{trackId}` collection (denied to all clients) so it
// never leaks to catalog readers. Audio master OBJECTS are NOT in Firestore;
// they live in private Storage (masters/... denied to all clients — see
// storage.rules).
service cloud.firestore {
  match /databases/{database}/documents {
    // Public catalog collections are world-readable, writes are admin-only.
    match /artists/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /releases/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /tracks/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /products/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Orders are admin-only (never publicly readable) — Polar order mirror.
    match /orders/{doc} {
      allow read, write: if isAdmin();
    }

    // Private track master paths: deny ALL client access. The admin SDK
    // bypasses rules, so the engine still reads/writes; no client may touch
    // these, keeping the private master object path out of public reach.
    match /track_masters/{doc=**} {
      allow read, write: if false;
    }

    // AI-provenance disclosure records (provenance/{trackId}): a TRANSPARENCY
    // artifact — PUBLIC-read so listeners can verify a recording is AI-generated,
    // but admin-write only. The admin SDK writes them; clients may only read.
    match /provenance/{doc=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // SENSITIVE ownership splits (rights/{releaseId}): deny ALL client access.
    // Splits are commercially sensitive and must never be publicly readable.
    // The admin SDK bypasses rules, so the engine still reads/writes; no client
    // may read or write — the splits stay out of the public release doc/page.
    match /rights/{doc=**} {
      allow read, write: if false;
    }

    // Engine collections: deny ALL client access. The admin SDK bypasses
    // rules, so the runtime is unaffected; no client may read or write.
    match /threads/{doc=**} {
      allow read, write: if false;
    }
    match /checkpoints/{doc=**} {
      allow read, write: if false;
    }
    match /checkpoint_writes/{doc=**} {
      allow read, write: if false;
    }
    match /memory/{doc=**} {
      allow read, write: if false;
    }

    // Default deny.
    match /{document=**} {
      allow read, write: if false;
    }

    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }
  }
}
